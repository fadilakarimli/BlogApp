generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

enum ReactionType {
  LIKE
  LOVE
  INSIGHTFUL
}


model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  posts        Post[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model Post {
  id           String            @id @default(cuid())
  authorId     String
  author       User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  status       PostStatus        @default(DRAFT)
  featured     Boolean           @default(false)
  publishedAt  DateTime?
  translations PostTranslation[]
  categories   PostCategory[]
  tags         PostTag[]
  comments     Comment[]
  reactions    Reaction[]
  views        PostView[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, publishedAt])
  @@index([featured, status])
}

model PostTranslation {
  id             String   @id @default(cuid())
  postId         String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  locale         String   @db.VarChar(2)
  slug           String
  title          String
  excerpt        String
  content        Json
  readTimeMinutes Int      @default(4)
  coverImageUrl  String?
  coverImageAlt  String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([postId, locale])
  @@unique([locale, slug])
  @@index([locale, title])
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  translations CategoryTranslation[]
  posts        PostCategory[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale      String   @db.VarChar(2)
  name        String
  description String?

  @@unique([categoryId, locale])
  @@unique([locale, name])
}

model Tag {
  id           String           @id @default(cuid())
  slug         String           @unique
  translations TagTranslation[]
  posts        PostTag[]
}

model TagTranslation {
  id     String @id @default(cuid())
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  locale String @db.VarChar(2)
  name   String

  @@unique([tagId, locale])
  @@unique([locale, name])
}

model PostCategory {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Comment {
  id          String        @id @default(cuid())
  postId      String
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String
  content     String        @db.Text
  status      CommentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([postId, status, createdAt])
}

model Reaction {
  id               String       @id @default(cuid())
  postId           String
  post             Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitorTokenHash String
  type             ReactionType
  createdAt        DateTime     @default(now())

  @@unique([postId, visitorTokenHash, type])
  @@index([postId, type])
}

model NewsletterSubscriber {
  id          String           @id @default(cuid())
  email       String           @unique
  locale      String           @default("en") @db.VarChar(2)
  status      SubscriberStatus @default(PENDING)
  confirmedAt DateTime?
  events      NewsletterEvent[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model NewsletterEvent {
  id           String               @id @default(cuid())
  subscriberId String
  subscriber   NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  type         String
  createdAt    DateTime             @default(now())

  @@index([subscriberId, createdAt])
}

model PostView {
  id               String   @id @default(cuid())
  postId           String
  post             Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitorTokenHash String?
  viewedAt         DateTime @default(now())

  @@index([postId, viewedAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
